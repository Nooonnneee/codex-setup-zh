# Windows 工具：脚本必须保持 CRLF，否则 .bat 在某些环境下解析异常
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# macOS：.command 双击运行，CRLF 会让 shebang 失效并报 bad interpreter
*.command text eol=lf
*.sh text eol=lf

# 其余文本统一 LF
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf

# 二进制
*.zip binary
*.exe binary
*.dmg binary
